{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "panda-simulator",
  "main": "worker.ts",
  "routes": [
    {
      "pattern": "simulator.pandacat.ai",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-09-20",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
