{
  "name": "@panda-intelligence/ai-os-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync:theme": "node scripts/sync-theme.mjs",
    "dev": "node scripts/sync-theme.mjs && vite",
    "build": "node scripts/sync-theme.mjs && tsc && vite build",
    "build:wasm": "bash scripts/build-qemu-wasm.sh",
    "build:wasm:firmware": "bash scripts/build-qemu-wasm.sh --firmware-only",
    "build:wasm:probe": "bash scripts/build-qemu-wasm.sh --probe-only",
    "check:browser-sd": "node scripts/check-browser-sd-card.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "node --test tests/*.test.mjs",
    "pack:web": "node scripts/pack-web.mjs",
    "serve:standalone": "node scripts/serve-dist.mjs",
    "audit:export": "node scripts/audit-export.mjs",
    "check:publication": "node scripts/audit-export.mjs --publication",
    "build:example": "bash scripts/build-example.sh",
    "pack:existing": "node scripts/pack-existing-runtime.mjs",
    "test:headless": "cargo test --locked --manifest-path headless/Cargo.toml",
    "test:product-fixtures": "cargo test --locked --manifest-path headless/Cargo.toml --features product-fixtures",
    "test:browser": "node tests/browser-runtime.smoke.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "js-fatfs": "^0.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~5.8.3",
    "vite": "^8.0.16"
  }
}
