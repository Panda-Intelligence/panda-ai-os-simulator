{
  "$schema": "./boards.schema.json",
  "defaultBoard": "mofei",
  "defaultHeadlessBin": "apps/simulator/headless/target/debug/mofei-sim-headless",
  "defaultCaseRoot": "test/simulator_e2e",
  "boards": [
    {
      "id": "mofei",
      "displayName": "Mofei (GDEQ0426 800x480)",
      "murphyBoard": "default",
      "firmware": "apps/panda-os/device/build/panda_os.bin",
      "rawWidth": 800,
      "rawHeight": 480,
      "framebufferWidth": 800,
      "framebufferHeight": 480,
      "framebufferFormat": "mono1",
      "outputWidth": 480,
      "outputHeight": 800,
      "touchI2cAddr": "0x38",
      "qemu": {
        "displayType": "ssd1677-gdeq0426",
        "touchType": "ft6336u"
      },
      "capabilities": ["input.touch", "display.mono1", "frontlight.dual", "button.left", "button.down", "button.up"],
      "keyMap": [
        { "id": 1, "label": "Enter" },
        { "id": 2, "label": "Next" },
        { "id": 0, "label": "ESC" }
      ]
    },
    {
