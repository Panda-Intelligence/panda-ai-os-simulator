+static void mofei_write_i64_return(CPUXtensaState* env, unsigned callinc, uint64_t value) {
+  env->regs[callinc * 4 + 2] = (uint32_t)value;
+  env->regs[callinc * 4 + 3] = (uint32_t)(value >> 32);
+}
