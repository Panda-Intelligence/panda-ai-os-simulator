+  if (mofei_trace_enabled("MOFEI_SIM_DEBUG_LIBGCC") && divdi_log < 32) {
+    fprintf(stderr, "[LIBGCC] __divdi3 %lld / %lld = %lld ret=0x%08x\n", (long long)dividend, (long long)divisor,
+            (long long)result, clean_addr);
