{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Murphy Simulator Board Registry",
  "type": "object",
  "required": ["defaultBoard", "defaultHeadlessBin", "defaultCaseRoot", "boards"],
  "properties": {
    "$schema": { "type": "string" },
    "defaultBoard": { "type": "string" },
    "defaultHeadlessBin": { "type": "string" },
    "defaultCaseRoot": { "type": "string" },
    "boards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/board" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "board": {
      "type": "object",
      "required": [
        "id",
        "displayName",
        "murphyBoard",
        "firmware",
        "rawWidth",
        "rawHeight",
        "framebufferWidth",
        "framebufferHeight",
        "framebufferFormat",
        "outputWidth",
        "outputHeight",
        "touchI2cAddr",
        "qemu",
        "keyMap"
      ],
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "murphyBoard": { "type": "string" },
        "firmware": { "type": "string" },
        "headlessBin": { "type": "string" },
        "caseRoot": { "type": "string" },
        "rawWidth": { "type": "integer", "minimum": 1 },
        "rawHeight": { "type": "integer", "minimum": 1 },
        "outputWidth": { "type": "integer", "minimum": 1 },
        "e2eCoordinateWidth": { "type": "integer", "minimum": 1 },
        "e2eCoordinateHeight": { "type": "integer", "minimum": 1 },
        "framebufferWidth": { "type": "integer", "minimum": 1 },
        "framebufferHeight": { "type": "integer", "minimum": 1 },
        "framebufferFormat": { "enum": ["mono1", "gray16"] },
        "outputHeight": { "type": "integer", "minimum": 1 },
        "touchI2cAddr": { "type": "string", "pattern": "^0x[0-9A-Fa-f]+$" },
        "qemu": {
          "type": "object",
          "required": ["displayType", "touchType"],
          "properties": {
            "displayType": { "type": "string" },
            "touchType": { "type": "string" }
          },
          "additionalProperties": false
        },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "keyMap": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "integer", "minimum": 0, "maximum": 255 },
              "label": { "type": "string" },
              "aliases": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
