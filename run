#!/usr/bin/env bash
# apps/simulator/run — One-click build + launch for the Panda AI OS simulator.
#
# Usage:
#   apps/simulator/run              # default: headless
#   apps/simulator/run headless     # build + run headless harness, output PNG
#   apps/simulator/run tauri        # build + launch Tauri GUI
#   apps/simulator/run setup        # first-time setup (integrate peripherals + build QEMU)
#   apps/simulator/run check        # verify prerequisites, report status
set -euo pipefail

# ── Resolve paths from this standalone checkout. Never inspect a parent repo. ──
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ── Paths (all relative to project root) ──
QEMU_CACHE_DIR="${QEMU_CACHE_DIR:-${SCRIPT_DIR}/.qemu-cache}"
QEMU_BIN="${QEMU_CACHE_DIR}/qemu/build/qemu-system-xtensa"
HEADLESS_CARGO="${SCRIPT_DIR}/headless/Cargo.toml"
QEMU_BUILD_SCRIPT="${SCRIPT_DIR}/scripts/build-qemu.sh"

# ── Configurable via env vars ──
DURATION="${MOFEI_SIM_DURATION:-${DURATION:-10}}"
OUT_PATH="${MOFEI_SIM_OUT:-/tmp/mofei-sim-output.png}"
MOFEI_SIM_SD_ROOT="${MOFEI_SIM_SD_ROOT:-${SCRIPT_DIR}/sdcard}"
MOFEI_SIM_HEAP_MODE="${MOFEI_SIM_HEAP_MODE:-device}"
PANDA_SIMULATOR_FIRMWARE="${PANDA_SIMULATOR_FIRMWARE:-${PANDA_OS_FIRMWARE_ELF:-}}"
PANDA_SIMULATOR_QEMU="${PANDA_SIMULATOR_QEMU:-${QEMU_BIN}}"

# ── Colors ──
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
BOLD='\033[1m'
RESET='\033[0m'

step()  { printf "${YELLOW}→${RESET} %s\n" "$*"; }
ok()    { printf "${GREEN}✓${RESET} %s\n" "$*"; }
fail()  { printf "${RED}✗${RESET} %s\n" "$*" >&2; }
die()   { fail "$@"; exit 1; }

case "${MOFEI_SIM_HEAP_MODE}" in
  device|test) ;;
  *) die "Invalid MOFEI_SIM_HEAP_MODE='${MOFEI_SIM_HEAP_MODE}'. Use 'device' or 'test'." ;;
esac

# ── Mode ──
MODE="${1:-headless}"
case "${MODE}" in
  headless|tauri|setup|check) ;;
  *) die "Unknown mode '${MODE}'. Usage: $0 [headless|tauri|setup|check]" ;;
esac
if [[ $# -gt 0 ]]; then
  shift
fi
SIMULATOR_ARGS=("$@")

parse_launcher_args() {
  local arg next
  local remaining=()
  while [[ $# -gt 0 ]]; do
    arg="$1"
    case "${arg}" in
      --firmware=*) PANDA_SIMULATOR_FIRMWARE="${arg#--firmware=}" ;;
      --firmware) [[ $# -ge 2 ]] || die "--firmware requires a path"; next="$2"; PANDA_SIMULATOR_FIRMWARE="${next}"; shift ;;
      --qemu=*) PANDA_SIMULATOR_QEMU="${arg#--qemu=}" ;;
      --qemu) [[ $# -ge 2 ]] || die "--qemu requires a path"; next="$2"; PANDA_SIMULATOR_QEMU="${next}"; shift ;;
      --sd-root=*) MOFEI_SIM_SD_ROOT="${arg#--sd-root=}" ;;
      --sd-root) [[ $# -ge 2 ]] || die "--sd-root requires a path"; next="$2"; MOFEI_SIM_SD_ROOT="${next}"; shift ;;
      *) remaining+=("${arg}") ;;
    esac
    shift
  done
  SIMULATOR_ARGS=("${remaining[@]}")
}
parse_launcher_args "${SIMULATOR_ARGS[@]}"
export MOFEI_SIM_SD_ROOT MOFEI_SIM_HEAP_MODE PANDA_SIMULATOR_QEMU

# ── Prerequisite checks ──
check_prerequisites() {
  local ok_count=0
  local fail_count=0

  if command -v cargo &>/dev/null; then
    ok "cargo found"
    ok_count=$((ok_count + 1))
  else
    fail "cargo not found (install Rust)"
    fail_count=$((fail_count + 1))
  fi

  if [[ -x "${PANDA_SIMULATOR_QEMU}" ]]; then
    ok "QEMU binary: ${PANDA_SIMULATOR_QEMU}"
    ok_count=$((ok_count + 1))
  else
    fail "QEMU binary not executable: ${PANDA_SIMULATOR_QEMU}"
    fail_count=$((fail_count + 1))
  fi
  ok "Heap mode: ${MOFEI_SIM_HEAP_MODE}"
  ok "Simulator board: ${MOFEI_SIM_BOARD:-mofei}"
  if [[ -n "${PANDA_SIMULATOR_FIRMWARE}" && -f "${PANDA_SIMULATOR_FIRMWARE}" ]]; then
    ok "Firmware: ${PANDA_SIMULATOR_FIRMWARE}"
  elif [[ "${MODE}" == "headless" || "${MODE}" == "tauri" ]]; then
    fail "Firmware is required; pass --firmware PATH or PANDA_SIMULATOR_FIRMWARE"
    fail_count=$((fail_count + 1))
  else
    ok "Firmware: not selected (required only for launch)"
  fi
  ok "SD root: ${MOFEI_SIM_SD_ROOT}"

  printf "\n  ${BOLD}%d ok, %d missing${RESET}\n\n" "${ok_count}" "${fail_count}"
  return "${fail_count}"
}

ensure_qemu_fresh() {
  QEMU_CACHE_DIR="${QEMU_CACHE_DIR}" "${QEMU_BUILD_SCRIPT}"
}

# ── Prepare the caller-owned SD root ──
ensure_sd_root() {
  mkdir -p "${MOFEI_SIM_SD_ROOT}"
  ok "SD card root: ${MOFEI_SIM_SD_ROOT}"
}

# ── Build headless harness ──
build_headless() {
  step "Building headless harness..."
  cargo build --locked --manifest-path "${HEADLESS_CARGO}" --release
}

case_artifact_screenshot_path() {
  local i arg
  for ((i = 0; i < ${#SIMULATOR_ARGS[@]}; i++)); do
    arg="${SIMULATOR_ARGS[$i]}"
    case "${arg}" in
      --artifacts=*)
        printf '%s/screenshot.png\n' "${arg#--artifacts=}"
        return 0
        ;;
      --artifacts)
        if ((i + 1 < ${#SIMULATOR_ARGS[@]})); then
          printf '%s/screenshot.png\n' "${SIMULATOR_ARGS[$((i + 1))]}"
          return 0
        fi
        ;;
    esac
  done
  return 1
}

simulator_args_have_board() {
  local arg
  for arg in "${SIMULATOR_ARGS[@]}"; do
    case "${arg}" in
      --board|--board=*) return 0 ;;
    esac
  done
  return 1
}

# ── Run headless simulation ──
run_headless() {
  step "Running headless simulation (${DURATION}s)..."
  local board_args=()
  if ! simulator_args_have_board; then
    board_args=(--board "${MOFEI_SIM_BOARD:-mofei}")
  fi
  cargo run --locked --manifest-path "${HEADLESS_CARGO}" --release --bin mofei-sim-headless -- \
    --firmware "${PANDA_SIMULATOR_FIRMWARE}" \
    "${board_args[@]}" \
    --heap-mode "${MOFEI_SIM_HEAP_MODE}" \
    --qemu "${PANDA_SIMULATOR_QEMU}" \
    --duration "${DURATION}" \
    --out "${OUT_PATH}" \
    --sd-root "${MOFEI_SIM_SD_ROOT}" \
    --serial \
    "${SIMULATOR_ARGS[@]}"

  if [[ -f "${OUT_PATH}" ]]; then
    ok "Screenshot saved: ${OUT_PATH}"
    return 0
  fi

  local artifact_screenshot=""
  if artifact_screenshot="$(case_artifact_screenshot_path)" && [[ -f "${artifact_screenshot}" ]]; then
    ok "Screenshot saved: ${artifact_screenshot}"
    return 0
  else
    fail "No screenshot produced"
    return 1
  fi
}

# ── Run Tauri GUI ──
run_tauri() {
  [[ -n "${PANDA_SIMULATOR_FIRMWARE}" ]] || die "Firmware is required; pass --firmware PATH or PANDA_SIMULATOR_FIRMWARE"
  [[ -f "${PANDA_SIMULATOR_FIRMWARE}" ]] || die "Firmware not found at ${PANDA_SIMULATOR_FIRMWARE}"
  export PANDA_SIMULATOR_FIRMWARE
  step "Launching Tauri dev..."
  (cd "${SCRIPT_DIR}" && npm run tauri dev)
}

# ── First-time setup ──
run_setup() {
  step "Acquiring and building the pinned QEMU runtime..."
  QEMU_CACHE_DIR="${QEMU_CACHE_DIR}" "${QEMU_BUILD_SCRIPT}"
  ok "Setup complete"
}

# ── Main dispatch ──
main() {
  case "${MODE}" in
    check)
      printf "\n${BOLD}Simulator prerequisites check${RESET}\n\n"
      check_prerequisites
      exit $?
      ;;
    setup)
      run_setup
      ;;
    headless)
      check_prerequisites || die "Prerequisites missing. Pass explicit firmware and QEMU paths."
      ensure_sd_root
      build_headless
      run_headless
      ;;
    tauri)
      check_prerequisites || die "Prerequisites missing. Pass explicit firmware and QEMU paths."
      ensure_sd_root
      run_tauri
      ;;
  esac
}

main
